{
  "record_type": "JASONS_GRAY_BABY_SERIES",
  "version": "0.1.0",
  "status": "PUBLIC_CREATIVE_SHELL",
  "purpose": "Give a child a neutral public shell for creative expression while preserving richer meaning, identity, authorship, and parental context inside a protected private layer.",
  "core_model": {
    "public_layer": {
      "name": "GRAY_SHELL",
      "contains": [
        "synthetic or parent-approved art",
        "neutral public metadata",
        "age-appropriate creative prompts",
        "non-political display labels"
      ],
      "prohibits": [
        "political affiliation inference from color",
        "gang affiliation inference from color",
        "criminality inference from style",
        "personality diagnosis",
        "behavioral advertising profile",
        "facial or identity recognition",
        "precise location or schedule disclosure"
      ]
    },
    "protected_layer": {
      "name": "PARENTAL_CREATION_CORE",
      "access": "PRIVATE_OR_LOCAL_ONLY",
      "contains": [
        "child-selected meaning",
        "parental context",
        "original drafts",
        "private stories",
        "consent records",
        "authorship and correction receipts"
      ],
      "public_repository_storage": false
    }
  },
  "creative_freedom": {
    "color_is_expression_not_identity": true,
    "red_does_not_imply_political_affiliation": true,
    "blue_does_not_imply_gang_or_political_affiliation": true,
    "symbols_require_child_or_parent_supplied_context": true,
    "machine_inference_of_intent": "PROHIBITED"
  },
  "parental_pincer": {
    "trigger_conditions": [
      "unapproved profiling",
      "political labeling",
      "gang labeling",
      "identity inference",
      "retaliation",
      "unauthorized data collection",
      "public-private layer collapse",
      "attempted use of creative work as evidence of guilt or character"
    ],
    "response_sequence": [
      "FREEZE_AUTOMATED_PROCESSING",
      "PRESERVE_ORIGINAL_OUTPUT_AND_INPUT",
      "RECORD_THE_LABEL_OR_INFERENCE_VERBATIM",
      "IDENTIFY_SYSTEM_AND_MODEL_VERSION",
      "NOTIFY_PARENT_OR_AUTHORIZED_STEWARD",
      "ALLOW_CHILD_AND_PARENT_CORRECTION",
      "ISSUE_APPEND_ONLY_CHALLENGE_RECEIPT",
      "REQUIRE_HUMAN_REVIEW_BEFORE_REUSE_OR_PUBLICATION"
    ],
    "automatic_accusation": false,
    "automatic_legal_escalation": false,
    "authority_created": false
  },
  "government_and_presidential_system_boundary": {
    "rule": "No government, presidential, campaign, law-enforcement, contractor, platform, or AI system receives special permission to infer ideology, guilt, gang membership, risk, or intent from a child's colors or creative expression.",
    "specific_targeting_claim_verified": false,
    "protection_applies_without_proving_targeting": true,
    "lawful_orders_and_existing_rights": "EXTERNAL_TO_THIS_ARTIFACT"
  },
  "child_rights": [
    "CREATE_WITHOUT_POLITICAL_LABELING",
    "CHOOSE_OR_CHANGE_MEANING",
    "USE_COLOR_WITHOUT_IDENTITY_INFERENCE",
    "INSPECT_PUBLIC_OUTPUT",
    "CORRECT_OR_WITHDRAW_PUBLIC_OUTPUT",
    "KEEP_PRIVATE CONTEXT PRIVATE",
    "RECEIVE_AGE_APPROPRIATE_EXPLANATIONS"
  ],
  "parental_rights_and_duties": [
    "PRESERVE_CHILD_SAFETY_AND_PRIVACY",
    "APPROVE_PUBLICATION_SCOPE",
    "DOCUMENT_CORRECTIONS",
    "AVOID_SPEAKING_OVER_CHILD_WHEN_CHILD_CAN PARTICIPATE",
    "FOLLOW_EXISTING_LAWFUL_ORDERS",
    "DO_NOT_USE_THE_CHILD_AS_A_POLITICAL_WEAPON"
  ],
  "invariants": [
    "CHILD_IS_PROTECTED_CENTER",
    "PUBLIC_GRAY_SHELL_IS_NOT_THE_CHILD",
    "PRIVATE_CORE_NEVER_DEFAULTS_TO_PUBLIC",
    "COLOR_IS_NOT POLITICAL_OR_CRIMINAL EVIDENCE",
    "NO_MACHINE_OUTPUT_CREATES_AUTHORITY",
    "NO_MUTATION_OF_HISTORICAL_RECORDS",
    "NO_REAL_CHILD_DATA_IN_PUBLIC_GITHUB",
    "CORRECTIONS_ARE_APPEND_ONLY"
  ],
  "repository_policy": {
    "public_allowed": [
      "schemas",
      "policies",
      "synthetic fixtures",
      "neutral templates",
      "audit receipts without PII"
    ],
    "public_prohibited": [
      "real child identity",
      "private artwork without explicit approval",
      "school or medical identifiers",
      "precise location or schedules",
      "private parental narratives"
    ]
  },
  "execution_authority": false,
  "publication_authority": "PARENT_OR_AUTHORIZED_STEWARD",
  "legal_authority": false
}
